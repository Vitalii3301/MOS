 "architecture": {
  "lifecycle.py": "one life cycle for skills, antimeme genes and gene memes: screen -> materialize -> evidence -> install (activate + serve once, rollback) -> verdict -> forward; a crashing stage is a refusal; every decision keeps its trail",
  "breed.py": "a cell breeds the next gene version from its own labelled evidence: parent + sparse logistic correction, judged out-of-fold (5 folds), recipe fixed before any run and never tuned",
  "evidence": "every item has a source and a labeller; a gene is never judged on items it was fitted on (peers leave them out; the breeder uses stored out-of-fold decisions)"
 },
 "adoption_rule": {
  "now": "significant/v2: exact sign test over all discordant items p<=0.05 in favour of the new gene; not significantly worse on either axis; false-alarm rate within 0.15 or not above the current gene's",
  "why_changed": "rule 1 decided on single-item differences; all its earlier adoptions/refusals were within noise (see grok_review_20261119.json)",
  "disclosure": "the switch was made AFTER seeing the first live breeding refused under rule 1 (below). That case motivated the change and is not evidence for the rule; the peers' decisions and the report set are."
 },
